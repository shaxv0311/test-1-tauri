  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRTdEODcxNEFCOTdCMDgKUldRSWU3bEtjZGpuSUN0RlpydXhhTllkRzRwTGUvdDdQbTNYc3pjbStjSE9teHRmUXdyS1pucmIK",
      "endpoints": [
        "https://github.com/shaxv0311/test-1-tauri-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
