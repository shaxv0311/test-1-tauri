{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-printer",
  "description": "Printer access and app updates for the Windows desktop application",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "printer:default",
    "printer:printing",
    "updater:default",
    "process:default",
    "dialog:default",
    "core:window:allow-title",
    "core:window:allow-set-title"
  ]
}
