{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.medical.loopspring.co.in/**"
        }
      ]
    },
    "fs:allow-write-file",
    "dialog:allow-save",
    "vnidrop-share:default",
    "notification:default",
    "push-notifications:default"
  ]
}
